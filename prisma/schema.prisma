// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String  @id @default(uuid())
  email    String  @unique
  uniqueKey String @unique
  password String
  isEmailVerified Boolean @default(false)
  isActive Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projects Project[]
}
model Developer {
  id        String  @id @default(uuid())
  name      String?
  email     String  @unique
  isEmailVerified Boolean @default(false)
  profilePicture Json?

  username String?
  bio String?
  coverPicture Json?
  emailToken String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Project {
  id        String  @id @default(uuid())
  name      String
  description String
  clientId String @unique
  clientSecret String @unique
  userId String
  slug String @unique
  user User @relation(fields: [userId], references: [id])
  isActive Boolean
  traces TraceSpan[]
  metrics Metric[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 model TraceSpan {
  id                      String     @id @default(uuid())
  name                    String
  scopeName               String?
  traceId                 String?    // Null for root trace, non-null for spans to reference their trace
  spanId                  String   @unique()    // Null for traces, non-null for spans
  parentSpanId            String?    // Null for traces and root spans, non-null for child spans
  kind                    Int?       // Null for trace, non-null for spans
  startTimeUnixNano       String?    // Optional for both traces and spans
  endTimeUnixNano         String?    // Optional for both traces and spans
  attributes              Json?      // Optional for both traces and spans
  droppedAttributesCount  Int?       // Optional for both traces and spans
  events                  Json?      // Optional for both traces and spans
  droppedEventsCount      Int?       // Optional for both traces and spans
  links                   Json?      // Optional for both traces and spans
  droppedLinksCount       Int?       // Optional for both traces and spans
  status                  Json?      // Optional for both traces and spans
  projectId               String?    // Only relevant for root traces
  project                 Project?   @relation(fields: [projectId], references: [id])
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  children                TraceSpan[] @relation("TraceSpanToTraceSpan")
  parent                  TraceSpan?  @relation("TraceSpanToTraceSpan", fields: [parentSpanId], references: [spanId])
}

model Metric {
  id        String  @id @default(uuid())
   content Json?
   name String
   description String
   unit String
  projectId String
  project Project @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}